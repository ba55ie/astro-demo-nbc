---
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'img'> & {
	caption: string;
};

const { alt, caption, class: className, src, ...props } = Astro.props;
---

<figure class:list={['polariod', className]}>
	<img alt={alt || caption} {src} {...props} />

	<figcaption>{caption}</figcaption>
</figure>

<style>
	.polariod {
		display: flex;
		flex-flow: column;

		padding: 0.75rem 0.75rem 1rem;

		background-color: #fff;

		border-radius: 2px;
		box-shadow:
			0 4px 10px rgb(0 0 0 / 0.25),
			0 1px 3px rgb(0 0 0 / 0.15);

		transform: rotate(var(--rotate-polaroid, 0deg));
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;

		img {
			inline-size: 100%;
			aspect-ratio: 4/3;
			object-fit: cover;
			background-color: #eee;
		}

		figcaption {
			margin-block-start: 0.75rem;

			font-size: 0.75rem;
			text-align: center;
		}

		&:is(:hover, :focus-visible &) {
			transform: scale(1.1) rotate(0deg);
			box-shadow:
				0 10px 20px rgb(0 0 0 / 0.35),
				0 3px 6px rgb(0 0 0 / 0.2);

			z-index: 1;
		}
	}
</style>
