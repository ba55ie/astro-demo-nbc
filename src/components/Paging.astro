---
export type Props = {
	total: number;
	start?: number;
	size?: number;
};

const { total, start = 0, size = 10 } = Astro.props;

const prev = Math.max(0, start - size);
const next = Math.min(total - size, start + size);
---

<div role="group">
	<a
		href={`${Astro.url.pathname}?start=${prev}&size=${size}`}
		role="button"
		aria-disabled={start <= 0}
	>
		🡨 Prev
	</a>

	<a
		href={`${Astro.url.pathname}?start=${next}&size=${size}`}
		role="button"
		aria-disabled={start + size >= total}
	>
		Next 🡪
	</a>
</div>

<style>
	[role='group'] {
		inline-size: auto;
	}

	[aria-disabled='true'] {
		--pico-background-color: var(--pico-contrast-background);
		--pico-border-color: var(--pico-contrast-border);
		--pico-color: var(--pico-contrast-inverse);

		opacity: 0.5;
		pointer-events: none;
	}
</style>
