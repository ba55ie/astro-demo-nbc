---
import { getCollection, render } from 'astro:content';

import 'reveal.js/reset.css';
import 'reveal.js/reveal.css';
import 'reveal.js/theme/black.css';

const slides = (await getCollection('slides')).sort(
	(a, b) => a.data.order - b.data.order,
);

const renderedSlides = await Promise.all(
	slides.map(async (slide) => {
		const { Content } = await render(slide);
		return { ...slide, Content };
	}),
);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Deck with Speaker Notes</title>
	</head>
	<body>
		<div class="reveal">
			<div class="slides">
				{renderedSlides.map(({ data, Content }) => (
					<section
						data-transition={data.transition}
						data-background={data.background}
					>
						<Content />
					</section>
				))}
			</div>
		</div>

		<script>
			import JSConfetti from 'js-confetti';
			import Reveal from 'reveal.js';
			import Notes from 'reveal.js/plugin/notes';

			const deck = new Reveal({
				hash: true,
				plugins: [Notes],
			});

			const jsConfetti = new JSConfetti();

			const fireEnlightenmentConfetti = () => {
				jsConfetti.addConfetti();
				jsConfetti.addConfetti({
					emojis: ['🚀', '🌅', '✨', '🧘', '🏝️', '🎉'],
					emojiSize: 50,
					confettiNumber: 30,
				});
			};

			deck.on('slidechanged', (event) => {
				const currentSlide = (event as unknown as { currentSlide?: HTMLElement })
					.currentSlide;
				if (currentSlide?.hasAttribute('data-confetti')) {
					fireEnlightenmentConfetti();
				}
			});

			document
				.querySelectorAll<HTMLElement>('[data-confetti]')
				.forEach((slide) => {
					slide.addEventListener('click', fireEnlightenmentConfetti);
				});

			deck.initialize();
		</script>

		<style is:global>
			.reveal section[data-confetti] h1 {
				text-shadow: 0 0 32px rgba(250, 204, 21, 0.7);
			}
		</style>
	</body>
</html>
