---
import DefaultLayout from '../../layouts/DefaultLayout.astro';

const { id } = Astro.params;

// A naive fetch you shouldn't do this in production!
const [post, comments] = await Promise.all([
	fetch(`https://jsonplaceholder.typicode.com/posts/${id}`).then((res) =>
		res.json(),
	),
	fetch(`https://jsonplaceholder.typicode.com/posts/${id}/comments`).then(
		(res) => res.json(),
	),
]);

if (!post?.id) {
	return Astro.rewrite('/404');
}
---

<DefaultLayout title={post.title}>
	<article>
		<header>
			<h1>{post.title}</h1>

			<a href="/posts">🡨 Return to the Posts</a>
		</header>

		<p>{post.body}</p>

		<aside>
			<h2>Comments</h2>

			{comments.map((comment) => (
				<blockquote>
					{comment.body}

					<footer>
						<cite>— {comment.email}</cite>
					</footer>
				</blockquote>
			))}
		</aside>
	</article>
</DefaultLayout>

<style>
	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;

		> * {
			margin-block: 0;
		}
	}

	:is(p, blockquote) {
		white-space: pre-line;
	}
</style>
