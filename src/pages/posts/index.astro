---
import DefaultLayout from '../../layouts/DefaultLayout.astro';
import Paging from '../../components/Paging.astro';

const title = 'Posts';

const start = Number(Astro.url.searchParams.get('start') ?? 0);
const size = Number(Astro.url.searchParams.get('size') ?? 10);

const posts = await fetch('https://jsonplaceholder.typicode.com/posts').then(
	(res) => res.json(),
);
---

<DefaultLayout title={title}>
	<h1>{title}</h1>

	<ol start={start + 1}>
		{posts.slice(start, start + size).map((post) => (
			<li>
				<a href={`/posts/${post.id}`}>{post.title}</a>
			</li>
		))}
	</ol>

	<Paging {size} {start} total={posts.length} />
</DefaultLayout>
