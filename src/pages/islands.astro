---
import DefaultLayout from '@/layouts/DefaultLayout.astro';

import VueAlert from '@/components/Alert.vue';
import ReactCounter from '@/components/counter/Counter.tsx';
import VueCounter from '@/components/counter/Counter.vue';

const title = 'Components';

const count = 1337;
---

<DefaultLayout title={title}>
	<article>
		<header>
			<h2>
				Hydrated Islands (<code>client:load</code>)
			</h2>
			<p>Interactive hydrated Islands</p>
		</header>

		<VueAlert client:load icon="🚀">
			Server-rendered HTML hydrated on the client using Astro's Islands
			architecture.
		</VueAlert>

		<div class="grid">
			<ReactCounter client:load count={count} />
			<VueCounter client:load count={count} />
		</div>
	</article>
</DefaultLayout>

<style>
	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;

		> * {
			margin: 0;
		}
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1.5rem;
	}
</style>
